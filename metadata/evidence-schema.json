{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://migrate-framework.local/schemas/evidence-item.json",
  "title": "EvidenceItem",
  "description": "Structured evidence collected during migration discovery and ingestion",
  "type": "object",
  "required": ["id", "type", "source", "subject", "collected_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique evidence identifier"
    },
    "type": {
      "type": "string",
      "enum": [
        "service",
        "api_endpoint",
        "http_dependency",
        "database",
        "database_table",
        "framework",
        "build_artifact",
        "deployment_unit",
        "trace_span",
        "landscape_smell",
        "bounded_context",
        "team_ownership",
        "config_property",
        "migration_hypothesis",
        "architecture_decision",
        "migration_phase",
        "playbook_task"
      ]
    },
    "source": {
      "type": "string",
      "description": "Adapter or artifact that produced this evidence"
    },
    "subject": {
      "type": "string",
      "description": "Primary entity this evidence refers to (service id, table name, etc.)"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1.0
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true,
      "description": "Type-specific payload"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation", "target"],
        "properties": {
          "relation": {
            "type": "string",
            "enum": [
              "depends_on",
              "owns",
              "exposes",
              "uses",
              "stores_in",
              "calls",
              "belongs_to",
              "targets"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
